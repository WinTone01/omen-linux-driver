[Unit]
Description=OMEN 16-ap0xxx fan egrisi servisi
Documentation=https://github.com/WinTone01/omen-linux-driver
# hp-wmi'nin hwmon'u hazir olmadan baslarsak pwm1 bulunamaz.
After=systemd-modules-load.service
ConditionPathExists=/sys/class/dmi/id/board_name

[Service]
Type=simple
ExecStart=/usr/bin/omend --config /etc/omen/omend.toml
Restart=on-failure
RestartSec=5

# Guvenlik kurali 1, ucuncu kapi: daemon SIGKILL ile olduyse Drop
# calismaz ve fan son setpoint'te kalir. Bu satir her cikis yolunda
# fani EC'ye geri verir. '-' oneki: bu adim basarisiz olsa bile
# servisin kapanmasini engellemesin.
ExecStopPost=-/usr/bin/omend --restore-auto

# Yalnizca sysfs'e yaziyoruz; geri kalan her sey kapali olabilir.
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# /sys varsayilan olarak salt okunur baglanir; yazacagimiz iki yolu aciyoruz.
ProtectSystem=strict
ReadWritePaths=/sys/class/hwmon /sys/devices

# Socket buraya acilir; systemd dizini olusturur ve kapanista siler.
# /run'in tamamini yazilabilir yapmaktan iyi. Dizin 0755, erisimi
# socket'in kendi izinleri (0660, grup omen) belirliyor.
RuntimeDirectory=omend
RuntimeDirectoryMode=0755
PrivateNetwork=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
