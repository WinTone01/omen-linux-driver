[Unit]
Description=OMEN 16-ap0xxx fan curve service
Documentation=https://github.com/WinTone01/omen-linux-driver
# Starting before hp-wmi's hwmon is ready means pwm1 will not be found.
After=systemd-modules-load.service
ConditionPathExists=/sys/class/dmi/id/board_name

[Service]
Type=simple
# The process runs as root (needed to write sysfs) but with the supplementary
# group 'omen'. That way the socket it creates is already root:omen and the
# daemon does not have to chown it - CapabilityBoundingSet is empty, so
# CAP_CHOWN is gone anyway. systemd refuses to start the unit if the group is
# missing, so the sysusers file must be installed.
Group=omen
ExecStart=/usr/bin/omend --config /etc/omen/omend.toml
Restart=on-failure
RestartSec=5

# Safety rule 1, third door: if the daemon was killed with SIGKILL, Drop does
# not run and the fan stays at its last setpoint. This line returns it to the
# EC on every exit path. The '-' prefix means a failure here must not block
# the service from stopping.
ExecStopPost=-/usr/bin/omend --restore-auto

# We only write to sysfs; everything else can be shut off.
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# /sys is mounted read-only by default; open the paths we write to. /etc/omen
# is writable because saving a curve from omenctl or the GUI rewrites the
# config file - the daemon then re-reads it, so the file is the only place a
# curve lives.
ProtectSystem=strict
ReadWritePaths=/sys/class/hwmon /sys/devices /etc/omen

# The socket goes here; systemd creates the directory and removes it on stop.
# Better than making all of /run writable. The directory is 0755 and access is
# governed by the socket's own permissions (0660, group omen).
RuntimeDirectory=omend
RuntimeDirectoryMode=0755
PrivateNetwork=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
