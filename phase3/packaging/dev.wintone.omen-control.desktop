# The file name and StartupWMClass both match the app's Wayland app_id
# (tauri.conf identifier, with enableGTKAppId). Without that match the window
# is not associated with this entry and the taskbar, Alt+Tab and the launcher
# all show a generic icon instead of the logo.
[Desktop Entry]
Type=Application
Name=OMEN Control
GenericName=Fan and Lighting Control
Comment=Fan curve, thermal profile and RGB keyboard control for the HP OMEN 16-ap0xxx
Exec=omen-ui
Icon=omen-control
Terminal=false
Categories=System;Settings;HardwareSettings;
Keywords=fan;thermal;rgb;keyboard;backlight;omen;
StartupNotify=true
StartupWMClass=dev.wintone.omen-control
