# StartupWMClass must match the window's Wayland app_id, or the taskbar,
# Alt+Tab and the launcher all show a generic icon instead of the logo.
#
# That app_id is "omen-ui", the program name. This is GTK3 (webkit2gtk-4.1),
# and GTK3 takes the Wayland app_id from g_get_prgname() - not from the
# GApplication id, which is what GTK4 does. Setting a GTK application id
# changed the name on the session bus and nothing about the window, while
# costing a crash on the second launch (see single.rs), so it is off.
[Desktop Entry]
Type=Application
Name=OMEN Control
GenericName=Fan and Lighting Control
Comment=Fan curve, thermal profile and RGB keyboard control for the HP OMEN 16-ap0xxx
Exec=omen-ui
Icon=omen-control
Terminal=false
Categories=System;Settings;HardwareSettings;
Keywords=fan;thermal;rgb;keyboard;backlight;omen;
StartupNotify=true
StartupWMClass=omen-ui
